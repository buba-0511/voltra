# Self-contained build (root directory = backend/) so each Railway
# service can be a plain subfolder deploy, no shared repo-root context.
# data/ here is a copy of the repo-root data/ (see ../data) - static
# dataset files from the challenge, not expected to change.
FROM golang:1.26-alpine AS build
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /server ./cmd/server

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /server /server
COPY data /data
ENV DATA_DIR=/data
EXPOSE 8080
CMD ["/server"]
